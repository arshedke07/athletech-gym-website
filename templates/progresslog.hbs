<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Gym Progress Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom CSS -->
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding-top: 70px;
        }

        .card {
            border-radius: 1rem;
            background-color: #ffffff;
            border: none;
        }

        h2,
        h4,
        h5 {
            font-weight: 600;
        }

        .progress {
            height: 24px;
            font-size: 0.9rem;
        }

        .progress-bar {
            font-weight: 500;
        }

        .list-group-item {
            font-size: 0.95rem;
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Athletech</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Left Nav -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        {{#if UserName}}
                        <a class="nav-link" href="/userhome">Home</a>
                        {{else if TrainerName}}
                        <a class="nav-link" href="/trainerhome">Home</a>
                        {{else}}
                        <a class="nav-link" href="/">Home</a>
                        {{/if}}
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Page 1</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Page 2</a>
                    </li>
                </ul>

                <!-- Right Nav -->
                <ul class="navbar-nav">
                    {{#if UserName}}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                            aria-expanded="false">
                            {{UserName}}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="/logout">Logout</a></li>
                        </ul>
                    </li>
                    {{else if TrainerName}}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                            aria-expanded="false">
                            {{TrainerName}}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="/logout">Logout</a></li>
                        </ul>
                    </li>
                    {{else}}
                    <li class="nav-item">
                        <a class="nav-link" href="/loginUser"><i class="bi bi-person"></i> Login</a>
                    </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Body Container -->
    <div class="container mt-5">
        <h2 class="mb-4">Welcome Back, {{UserName}} 👋</h2>

        <!-- Progress Overview Cards -->
        <div class="row g-4 mb-5">
            <!-- Weight -->
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Weight</h6>
                    <h4 class="card-title">
                        {{#if Goals.currentWeight}}
                        {{Goals.currentWeight}} kg
                        {{else}}
                        -
                        {{/if}}
                    </h4>
                    <p class="mb-1 text-success">⬇️ Lost 4.5 kg in 5 weeks</p>
                    <small class="text-muted">Goal:
                        {{#if Goals.weightGoal}}{{Goals.weightGoal}} kg{{else}}-{{/if}}
                    </small><br>
                    <small class="text-muted">Started At:
                        {{#if History.currentWeight}}{{History.currentWeight}} kg{{else}}-{{/if}}
                    </small>
                </div>
            </div>

            <!-- Lift -->
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">
                        {{#if Goals.liftType}}{{Goals.liftType}}{{else}}-{{/if}}
                    </h6>
                    <h4 class="card-title">
                        {{#if Goals.currentLift}}{{Goals.currentLift}} kg{{else}}-{{/if}}
                    </h4>
                    <p class="mb-1 text-success">⬆️ +15 kg since start</p>
                    <small class="text-muted">Goal:
                        {{#if Goals.liftGoal}}{{Goals.liftGoal}} kg{{else}}-{{/if}}
                    </small><br>
                    <small class="text-muted">Started At:
                        {{#if History.currentLift}}{{History.currentLift}} kg{{else}}-{{/if}}
                    </small>
                </div>
            </div>

            <!-- Cardio -->
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">
                        {{#if Goals.cardioType}}{{Goals.cardioType}}{{else}}-{{/if}}
                    </h6>
                    <h4 class="card-title">
                        {{#if Goals.currentCardio}}{{Goals.currentCardio}} km{{else}}-{{/if}}
                    </h4>
                    <p class="mb-1 text-success">⬆️ +2.7 km in 3 weeks</p>
                    <small class="text-muted">Goal:
                        {{#if Goals.cardioGoal}}{{Goals.cardioGoal}} km{{else}}-{{/if}}
                    </small><br>
                    <small class="text-muted">Started At:
                        {{#if History.currentCardio}}{{History.currentCardio}} km{{else}}-{{/if}}
                    </small>
                </div>
            </div>
        </div>

        <!-- Second Row -->
        <div class="row g-4 mb-5">
            <!-- Body Fat -->
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Body Fat Percentage</h6>
                    <h4 class="card-title">
                        {{#if Goals.currentBodyFat}}{{Goals.currentBodyFat}}%{{else}}-{{/if}}
                    </h4>
                    <small class="text-muted">Goal:
                        {{#if Goals.bodyFatGoal}}{{Goals.bodyFatGoal}}%{{else}}-{{/if}}
                    </small><br>
                    <small class="text-muted">Started At:
                        {{#if History.currentBodyFat}}{{History.currentBodyFat}}%{{else}}-{{/if}}
                    </small>
                </div>
            </div>

            <!-- Placeholder Cards -->
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Calories Burned This Week</h6>
                    <h4 class="card-title">-</h4>
                    <p class="mb-1 text-success">Tracking coming soon!</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Workouts Logged This Week</h6>
                    <h4 class="card-title">-</h4>
                    <p class="mb-1 text-success">Tracking coming soon!</p>
                </div>
            </div>
        </div>

        <!-- Milestones -->
        <div class="card p-4 mb-5 shadow-sm">
            <h5 class="mb-3">🏁 Milestones Achieved</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">✅ Lost first 2 kg in 2 weeks</li>
                <li class="list-group-item">✅ Bench pressed 80kg in 4 weeks</li>
                <li class="list-group-item">✅ Completed a 5K run for the first time</li>
            </ul>
        </div>

        <!-- Update Form -->
        <div class="card p-4 shadow-sm mb-5">
            <h4 class="mb-4">🏋️ Update Your Goals In The Gym</h4>
            <h6>You can fill only those fields you want to focus on and leave others empty</h6>
            <br>
            <form id="progressForm">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="current_weight" class="form-label">Current Weight (kg)</label>
                        <input type="number" class="form-control" id="current_weight" name="current_weight"
                            placeholder="Enter current weight">
                    </div>
                    <div class="col-md-6">
                        <label for="weight_goal" class="form-label">Weight Goal (kg)</label>
                        <input type="number" class="form-control" id="weight_goal" name="weight_goal"
                            placeholder="Enter weight goal">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="cardio_type" class="form-label">Select Type of Cardio</label>
                    <select class="form-select" id="cardio_type" name="cardio_type">
                        <option selected disabled>Choose...</option>
                        <option value="Running">Running</option>
                        <option value="Walking">Walking</option>
                        <option value="Cycling">Cycling</option>
                    </select>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="current_cardio" class="form-label">Current Distance (km)</label>
                        <input type="number" class="form-control" id="current_cardio" name="current_cardio"
                            placeholder="Enter current distance">
                    </div>
                    <div class="col-md-6">
                        <label for="cardio_goal" class="form-label">Goal (km)</label>
                        <input type="number" class="form-control" id="cardio_goal" name="cardio_goal"
                            placeholder="Enter goal">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="lift_type" class="form-label">Lift Type</label>
                    <select class="form-select" id="lift_type" name="lift_type">
                        <option selected disabled>Choose...</option>
                        <option value="Bench Press">Bench Press</option>
                        <option value="DeadLift">DeadLift</option>
                        <option value="Squat">Squat</option>
                    </select>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="current_lift" class="form-label">Current Lift</label>
                        <input type="number" class="form-control" id="current_lift" name="current_lift"
                            placeholder="Current">
                    </div>
                    <div class="col-md-6">
                        <label for="lift_goal" class="form-label">Lift Goal</label>
                        <input type="number" class="form-control" id="lift_goal" name="lift_goal" placeholder="Goal">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="current_body_fat" class="form-label">Enter Your Current Body Fat (%)</label>
                        <input type="number" class="form-control" id="current_body_fat" name="current_body_fat"
                            placeholder="Enter current body fat">
                    </div>
                    <div class="col-md-6">
                        <label for="body_fat_goal" class="form-label">Enter Your Body Fat Goal (%)</label>
                        <input type="number" class="form-control" id="body_fat_goal" name="body_fat_goal"
                            placeholder="Your body fat goal">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Update Profile</button>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('progressForm').addEventListener('submit', async function (event) {
            event.preventDefault()

            const formData = new FormData(this)
            const json = {}

            formData.forEach((value, key) => json[key] = value);

            const userId = '{{UserId}}';

            const response = await fetch(`http://localhost:3001/progressService/${userId}`, {
                method: 'POST',
                headers: { 'Content-type': 'application/json' },
                body: JSON.stringify(json)
            })

            if (response.ok) {
                console.log('Data sent successfully!');
                // 🌀 Refresh the page
                window.location.reload();
            } else {
                console.error('Error submitting form:', response.statusText);
                alert('Failed to submit. Try again.');
            }
        })
    </script>
</body>

</html>